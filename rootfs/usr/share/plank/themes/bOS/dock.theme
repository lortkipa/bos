# bOS dock: frosted light glass, rounded top corners.

[PlankTheme]
TopRoundness=16
BottomRoundness=0
LineWidth=1
OuterStrokeColor=0;;0;;0;;38
FillStartColor=255;;255;;255;;178
FillEndColor=240;;242;;248;;178
